{
  "name": "sweetlink",
  "version": "0.2.2",
  "private": false,
  "description": "Controlled-browser automation CLI for SweetLink sessions.",
  "keywords": [
    "automation",
    "browser",
    "cli",
    "devtools",
    "sweetlink"
  ],
  "homepage": "https://github.com/steipete/sweetlink",
  "bugs": {
    "url": "https://github.com/steipete/sweetlink/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steipete/sweetlink.git"
  },
  "bin": {
    "sweetlink": "./dist/src/index.js",
    "sweetlinkd": "./dist/daemon/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./runtime/browser": {
      "types": "./dist/src/runtime/browser/index.d.ts",
      "import": "./dist/src/runtime/browser/index.js",
      "default": "./dist/src/runtime/browser/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "lint": "pnpm format:check && oxlint --deny-warnings ./src ./shared/src ./daemon/src ./tests",
    "lint:fix": "pnpm format && oxlint --fix ./src ./shared/src ./daemon/src ./tests",
    "standalone:post-sync": "tsx scripts/post-sync.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@steipete/sweet-cookie": "0.4.1",
    "arkregex": "^0.0.8",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.51.0",
    "html2canvas": "^1.4.1",
    "playwright-core": "^1.62.1",
    "puppeteer-core": "^25.9.0",
    "random-word-slugs": "^0.1.7",
    "tldjs": "^2.3.2",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "^7.10.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.11.0"
  },
  "packageManager": "pnpm@11.24.0"
}
